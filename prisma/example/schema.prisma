// Separate Prisma schema for the example/customer site.
// Uses SQLite — no external database server required.
// Customers would swap this for PostgreSQL/MySQL in production.

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/example-client"
}

datasource db {
  provider = "sqlite"
  url      = env("EXAMPLE_DATABASE_URL")
}

// ─── Blog Posts ──────────────────────────────────────────────────────

model Post {
  id          String   @id @default(cuid())
  auroraId    Int?     @unique @map("aurora_id")
  slug        String   @unique
  title       String
  excerpt     String   @default("")
  coverImage  String   @default("") @map("cover_image")
  publishedAt String   @map("published_at")
  seoTitle    String?  @map("seo_title")
  focusKeyword String? @map("focus_keyword")
  metaDescription String? @map("meta_description")
  status      String   @default("published")
  syncedAt    DateTime @default(now()) @map("synced_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  elements Element[]

  @@map("posts")
}

model Element {
  id          String @id @default(cuid())
  auroraId    String? @map("aurora_id")
  postId      String @map("post_id")
  order       Int
  elementType String @map("element_type")
  content     String // JSON stored as text (SQLite)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("elements")
}

// ─── Dictionary ──────────────────────────────────────────────────────

model Dictionary {
  id          String   @id @default(cuid())
  auroraId    Int?     @unique @map("aurora_id")
  name        String
  description String   @default("")
  subject     String?
  language    String?
  syncedAt    DateTime @default(now()) @map("synced_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  words Word[]

  @@map("dictionaries")
}

model Word {
  id           String  @id @default(cuid())
  auroraId     String? @map("aurora_id")
  dictionaryId String  @map("dictionary_id")
  keyword      String
  letter       String?
  description  String?
  focusKeyword String? @map("focus_keyword")
  definition   String  @default("{}") // JSON stored as text

  dictionary Dictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)

  @@unique([dictionaryId, keyword])
  @@map("words")
}
