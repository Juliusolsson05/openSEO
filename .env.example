# App secrets
AUTH_SECRET=replace-with-secure-random-secret
AUTH_TRUST_HOST=true
OPENSEO_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# App URLs
PORT=4720
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:4720
FRONTEND_URL=http://localhost:4720

# CORS allowlist for /api/* (comma-separated). Required in production if
# any cross-origin client calls the API. Leave unset to disable CORS headers
# entirely (same-origin only).
#   ALLOWED_ORIGINS=https://app.example.com,https://example.com
ALLOWED_ORIGINS=http://localhost:4720,http://localhost:3000

# Hostnames/IPs the Next.js dev server trusts for cross-origin dev warnings
# (useful for LAN testing on a phone). Comma-separated.
#   ALLOWED_DEV_ORIGINS=192.168.1.154,10.0.0.5
ALLOWED_DEV_ORIGINS=

# Infrastructure
# For local `npm run dev`, use docker-compose.debug.yml so these host ports exist.
# The one-command installer rewrites these to internal Compose service URLs.
DATABASE_URL=postgresql://openseo:openseo@localhost:5432/openseo
REDIS_URL=redis://localhost:6379

# AI providers
OPENAI_API_KEY=replace-openai-key
ANTHROPIC_API_KEY=replace-anthropic-key
GEMINI_API_KEY=replace-gemini-key

# Media providers
IDEOGRAM=replace-ideogram-key
PEXELS=replace-pexels-key

# Storage (default: local filesystem, no config needed)
# Set STORAGE_DRIVER=s3 for S3-compatible storage (AWS S3, Cloudflare R2, MinIO, etc.)
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=openseo
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_URL=https://cdn.example.com
