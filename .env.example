# ── Auth ──────────────────────────────────────────────────
AUTH_SECRET=replace-with-secure-random-secret

# ── App URLs ───────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Database / Redis ───────────────────────────────────────
DATABASE_URL=postgresql://nordtools:nordtools@localhost:5432/nordtools
REDIS_URL=redis://localhost:6379

# ── AI / Media Providers ───────────────────────────────────
OPENAI_API_KEY=replace-openai-key
ANTHROPIC_API_KEY=replace-anthropic-key
IDEOGRAM=replace-ideogram-key
LOGO_API_TOKEN=replace-logo-dev-token
PEXELS=replace-pexels-key

# ── Cloudinary ─────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=replace-cloud-name
CLOUDINARY_API_KEY=replace-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-cloudinary-api-secret
