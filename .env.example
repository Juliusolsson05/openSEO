# ════════════════════════════════════════════════════════════════════
# OpenSEO — Environment Configuration
# ════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the required values.
# The install.sh script does this automatically.
#
# Legend:
#   REQUIRED  — must be set before the app will start
#   OPTIONAL  — has a working default, change if needed
#   PROVIDER  — only needed if you use the feature
# ════════════════════════════════════════════════════════════════════


# ── REQUIRED: App Secrets ─────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Base64-encoded 32-byte key for AES-256-GCM encryption.
# Generate with: openssl rand -base64 32
OPENSEO_ENCRYPTION_KEY=


# ── REQUIRED: URLs ────────────────────────────────────────────────
# The public URL where users access OpenSEO.
NEXT_PUBLIC_SITE_URL=http://localhost:4720
FRONTEND_URL=http://localhost:4720

# Port the app is exposed on (host side).
# OPTIONAL — default: 4720
PORT=4720


# ── OPTIONAL: Infrastructure ──────────────────────────────────────
# For local dev only. Docker Compose overrides these with internal URLs.
# Only change if you use an external database or cache.
DATABASE_URL=postgresql://openseo:openseo@localhost:5432/openseo
REDIS_URL=redis://localhost:6379

# Password for the Postgres container. Change in production.
# OPTIONAL — default: openseo
DB_PASSWORD=openseo

# Docker image to use. Defaults to GHCR pre-built image.
# Set to "openseo" for local builds (docker compose build).
# APP_IMAGE=ghcr.io/juliusolsson05/openseo:latest


# ── OPTIONAL: CORS ────────────────────────────────────────────────
# Comma-separated origins allowed to call /api/* cross-origin.
# Leave empty to disable CORS headers (same-origin only).
#   Example: ALLOWED_ORIGINS=https://app.example.com,https://example.com
ALLOWED_ORIGINS=

# Hostnames the Next.js dev server trusts (LAN testing).
#   Example: ALLOWED_DEV_ORIGINS=192.168.1.154,10.0.0.5
ALLOWED_DEV_ORIGINS=


# ── OPTIONAL: Storage ─────────────────────────────────────────────
# Default: local filesystem (no config needed).
# Set to "s3" for S3-compatible storage (AWS S3, Cloudflare R2, MinIO, etc.)
STORAGE_DRIVER=local

# S3 settings (only when STORAGE_DRIVER=s3)
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=openseo
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_URL=https://cdn.example.com


# ── OPTIONAL: Worker ──────────────────────────────────────────────
# Set to 1 to disable the inline background worker (when running
# a dedicated worker process via docker compose --profile worker).
# DISABLE_INLINE_WORKER=0


# ── OPTIONAL: Public Site ─────────────────────────────────────────
# Company ID whose content is served on the /site/* public pages.
# Set this after your first company is created (check the database or
# the company settings page for the ID). Leave empty to disable /site/*.
# PUBLIC_CONTENT_COMPANY_ID=


# ── PROVIDER: AI ──────────────────────────────────────────────────
# At least one AI provider is needed for content generation.
# Keys can also be configured in the app UI (Settings > Integrations).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=


# ── PROVIDER: Media ───────────────────────────────────────────────
# Optional — enables AI image generation and stock photos.
IDEOGRAM=
PEXELS=
